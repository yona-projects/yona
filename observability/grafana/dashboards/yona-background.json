    {
      "id": 8,
      "type": "timeseries",
      "title": "백그라운드 일 시간 p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, result) (rate(yona_background_duration_milliseconds_bucket{job=\"yona\"}[5m])))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
