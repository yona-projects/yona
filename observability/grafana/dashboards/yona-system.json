        {
          "expr": "jvm_gc_max_data_size_bytes{job=\"yona\"}",
          "legendFormat": "최대",
          "range": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
