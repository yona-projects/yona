      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"yona\",area=\"heap\"})",
          "legendFormat": "사용",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{job=\"yona\",area=\"heap\"})",
          "legendFormat": "커밋",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
