        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (kind, result, reason) (increase(yona_vcs_pushes_total{job=\"yona\"}[5m]))",
          "legendFormat": "{{kind}} {{result}} {{reason}}",
          "range": true,
          "refId": "A",
