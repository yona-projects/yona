{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": "../../src/main/frontend/ts",
    "paths": { "yona/*": ["./*"] },
    "rootDir": "../../src/main/frontend/ts",
    "outDir": "../../build/generated/ts/static/assets/javascripts/esm",
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["../../src/main/frontend/ts/**/*.ts"]
}
