{
  "name": "yona-e2e",
  "version": "1.0.0",
  "description": "Playwright end-to-end coverage for every yona screen (auth, project, code, issue, PR, wiki, board, milestone, org, search, admin, oauth2, 2fa, sso).",
  "private": true,
