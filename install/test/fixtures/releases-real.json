public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":80251910,"digest":null,"download_count":1236,"created_at":"2023-01-09T18:26:08Z","updated_at":"2023-01-09T18:26:17Z","browser_download_url":"https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-h2-v1.16.0-bin.zip"},{"url":"https://api.github.com/repos/yona-projects/yona/releases/assets/91062309","id":91062309,"node_id":"RA_kwDOAuTIK84FbYAl","name":"yona-mysql-v1.16.0-bin.zip","label":null,"uploader":{"login":"doortts","id":520523,"node_id":"MDQ6VXNlcjUyMDUyMw==","avatar_url":"https://avatars.githubusercontent.com/u/520523?v=4","gravatar_id":"","url":"https://api.github.com/users/doortts","html_url":"https://github.com/doortts","followers_url":"https://api.github.com/users/doortts/followers","following_url":"https://api.github.com/users/doortts/following{/other_user}","gists_url":"https://api.github.com/users/doortts/gists{/gist_id}","starred_url":"https://api.github.com/users/doortts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doortts/subscriptions","organizations_url":"https://api.github.com/users/doortts/orgs","repos_url":"https://api.github.com/users/doortts/repos","events_url":"https://api.github.com/users/doortts/events{/privacy}","received_events_url":"https://api.github.com/users/doortts/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":82774806,"digest":null,"download_count":338,"created_at":"2023-01-09T18:32:43Z","updated_at":"2023-01-09T18:32:51Z","browser_download_url":"https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-mysql-v1.16.0-bin.zip"},{"url":"https://api.github.com/repos/yona-projects/yona/releases/assets/91061425","id":91061425,"node_id":"RA_kwDOAuTIK84FbXyx","name":"yona-v1.16.0-bin.zip","label":null,"uploader":{"login":"doortts","id":520523,"node_id":"MDQ6VXNlcjUyMDUyMw==","avatar_url":"https://avatars.githubusercontent.com/u/520523?v=4","gravatar_id":"","url":"https://api.github.com/users/doortts","html_url":"https://github.com/doortts","followers_url":"https://api.github.com/users/doortts/followers","following_url":"https://api.github.com/users/doortts/following{/other_user}","gists_url":"https://api.github.com/users/doortts/gists{/gist_id}","starred_url":"https://api.github.com/users/doortts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doortts/subscriptions","organizations_url":"https://api.github.com/users/doortts/orgs","repos_url":"https://api.github.com/users/doortts/repos","events_url":"https://api.github.com/users/doortts/events{/privacy}","received_events_url":"https://api.github.com/users/doortts/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":80320973,"digest":null,"download_count":1805,"created_at":"2023-01-09T18:23:21Z","updated_at":"2023-01-09T18:23:30Z","browser_download_url":"https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-v1.16.0-bin.zip"}],"tarball_url":"https://api.github.com/repos/yona-projects/yona/tarball/v1.16.0","zipball_url":"https://api.github.com/repos/yona-projects/yona/zipball/v1.16.0","body":"<img src=\"https://github.com/yona-projects/yona/raw/master/public/images/yona_logo.png\" width=\"300px\">\r\n\r\nYona v1.16 릴리즈 입니다.\r\n\r\nGit 저장소 기능이 내장된 이슈 관리도구인 Yona는 매월 약 12,000명+ 의 유저가 실제 업무에서 사용하고 있는  공개 SW입니다.\r\n\r\nDemo: https://repo.yona.io 에서 기능을 테스트해 볼 수 있습니다\r\n\r\n**이번 버전 한정 예외적으로 MySQL 버전을 추가 제공합니다.**\r\n\r\n새로운 기능\r\n---\r\n- 최근 읽은 이슈 목록\r\n   - 사이드바 및 유저메뉴에서 최근 읽은 이슈 목록이 표시됩니다.\r\n   - 여러 프로젝트에 걸쳐 작업할 경우 이슈 간 이동을 빠르게 할 수 있습니다.\r\n- 초안(Draft)으로 저장하기\r\n   - 작성에 시간이 걸리거나 미리 등록 후 나중에 공개하기 위한 기능으로 초안 작성 기능을 제공합니다.\r\n   - '발행'하기 전까지는 다른 사용자에게는 표시되지 않습니다.\r\n\r\n기능 개선 및 변경\r\n---\r\n- 최근 브라우저들의 변화에 대응한 호환성 업데이트\r\n- 사이드바(sidebar) UX 개선\r\n- 댓글 참조 링크(Permalink)를 직접적으로 표시\r\n- markdown library 업데이트\r\n- 모바일 뷰에서 사이드바가 좀 더 잘 표시되도록 수정\r\n- 글 작성시 복구 기능으로 불러온 내용이 있을 경우 복구 내용 삭제하는 버튼 표시\r\n- 이슈 목록 표시 성능 개선\r\n\r\n버그 수정\r\n---\r\n- 화면폭이 좁은 화면에서 첨부파일 삭제 버튼이 사라지는 버그\r\n- 대댓글에서 인용 표시를 사용했을때 글자가 크게 표시되는 버그\r\n\r\n## 배포파일\r\n**MariaDB 버전은 10.2 와 10.3 만 지원합니다.**\r\n\r\n마리아DB 10.1 을 사용중이신 분은 [MariaDB 버전 업그레이드 가이드](https://mariadb.com/kb/en/library/upgrading-from-mariadb-101-to-mariadb-102/)을 참고해서 업그레이드를 진행해 주세요. 생각보다 쉽게 가능합니다.\r\n\r\n- MariaDB 를 사용하는 기본 버전\r\n  - [yona-v1.16.0-bin.zip](https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-v1.16.0-bin.zip) \r\n- 내장 DB를 사용하는 경량버전\r\n  - [yona-h2-v1.16.0-bin.zip](https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-h2-v1.16.0-bin.zip)\r\n  - [H2 Embedded DB](https://www.h2database.com/html/main.html)가 포함되어 있습니다.\r\n  - 이 버전은 대규모 환경에서 사용하기엔 적절하지 않습니다. \r\n  - 예를 들면 출장이나 강의 혹은 프로젝트 지원이나 200명 이하의 작은 조직등에서 간단히 쓰다가 통째로 묶어서 보관/이동하는 용도로 사용하길 권장합니다. \r\n  - H2 DB 에서 MariaDB 로의 이전은 공식 지원하지 않습니다.\r\n\r\n### MySQL DB 지원 Yona \r\n\r\n- MySQL 5.7.x DB 와 호환되는 Yona v1.16 버전입니다.  \r\n- 이번 버전 한정 예외적으로 MySQL 버전을 추가 제공합니다. \r\n- 다른 MySQL 버전에서는 테스트 되지 않았습니다.\r\n- [yona-mysql-v1.16.0-bin.zip](https://github.com/yona-projects/yona/releases/download/v1.16.0/yona-mysql-v1.16.0-bin.zip) \r\n\r\n### Docker\r\n  -  @pokev25 님이 https://github.com/pokev25/docker-yona 를 통해 Docker 지원을 도와주고 계십니다. 늘 고맙습니다.","reactions":{"url":"https://api.github.com/repos/yona-projects/yona/releases/88241106/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"mentions_count":1}]
