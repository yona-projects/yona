# SQL Server 컨테이너 설치
version=v2.0.0
install_dir=/opt/yona
data_dir=/var/lib/yona
service.register=true
db.type=mssql
db.install=together
db.method=container
db.name=yona
db.user=yona
db.password_file=%SCENARIO%/secrets/db
db.admin_password_file=%SCENARIO%/secrets/admin
env.os=linux
env.java=/usr/bin/java
env.containers=podman
