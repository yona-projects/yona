# 서비스, PostgreSQL 컨테이너, 메일, HTTPS 프록시 뒤, 내장 SSH
version=v2.0.0
install_dir=/opt/yona
data_dir=/var/lib/yona
service.register=true
db.type=postgresql
db.install=together
db.method=container
db.name=yona
db.user=yona
db.password_file=%SCENARIO%/secrets/db
db.admin_password_file=%SCENARIO%/secrets/admin
site.hostname=git.example.com
site.scheme=https
site.behind_https_proxy=true
web.port=8080
mail.enabled=true
mail.host=smtp.example.com
mail.port=587
mail.ssl=false
mail.user=bot
mail.password_file=%SCENARIO%/secrets/mail
mail.from_user=yona
mail.from_domain=example.com
mail.mock=false
ssh.mode=builtin
ssh.port=2222
ssh.public_port=22
env.os=linux
env.distro=ubuntu
env.user=tester
env.java=/usr/lib/jvm/java-21-openjdk-amd64/bin/java
env.containers=docker
env.tz=Asia/Seoul
