# 따로 설치된 MariaDB, 모의 발송
version=v2.0.0
install_dir=/opt/yona
data_dir=/var/lib/yona
service.register=true
db.type=mariadb
db.install=separate
db.host=db.internal
db.port=3306
db.name=yona
db.user=yona
db.password_file=%SCENARIO%/secrets/db
mail.enabled=true
mail.host=smtp.example.com
mail.port=25
mail.ssl=true
mail.mock=true
env.os=linux
env.java=/usr/bin/java
